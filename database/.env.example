# Copy to .env and change for your machine. Never commit .env.
POSTGRES_USER=pgs
POSTGRES_PASSWORD=pgs
POSTGRES_DB=pgs

# Python (SQLAlchemy / Alembic)
DATABASE_URL=postgresql+psycopg://pgs:pgs@localhost:5432/pgs

# Go scraper (--storage=postgres) uses the same database without the driver prefix:
# DATABASE_URL=postgres://pgs:pgs@localhost:5432/pgs
