# One-off crawl (needs the optional `scraper` part). A template: SEEDS is filled in by envsubst, e.g.
#   SEEDS=https://example.gov.np envsubst < k8/jobs/on-demand/scraper-crawl.yaml.tmpl | kubectl create -f -
# or `make k8s-crawl SEEDS=...` from scraper/. For a seed file baked into the image, replace
# --seeds with --seeds-file=/configs/seeds.example.txt.
apiVersion: batch/v1
kind: Job
metadata:
  generateName: scraper-crawl-
  namespace: pgs-search-engine
  labels:
    app.kubernetes.io/name: scraper-crawl
    app.kubernetes.io/part-of: pgs-search-engine
spec:
  backoffLimit: 0
  ttlSecondsAfterFinished: 3600
  template:
    metadata:
      labels:
        app.kubernetes.io/name: scraper-crawl
    spec:
      restartPolicy: Never
      automountServiceAccountToken: false
      enableServiceLinks: false
      securityContext:
        runAsNonRoot: true
        runAsUser: 65532
        runAsGroup: 65532
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: scraper
          image: pgs-search-engine/scraper-cli:local
          imagePullPolicy: IfNotPresent
          args:
            - "--seeds=${SEEDS}"
            - "--max-depth=2"
            - "--max-pages=200"
            - "--max-pages-per-domain=50"
            - "--same-host-only=false"
          envFrom:
            - configMapRef:
                name: scraper-config
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities: { drop: ["ALL"] }
          resources:
            requests: { cpu: 20m, memory: 32Mi }
            limits: { memory: 128Mi }
