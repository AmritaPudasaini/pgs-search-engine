# Secrets for the Kubernetes deployment. Copy to k8/secrets/secrets.env (never commit it):
#   cp k8/secrets/secrets.env.example k8/secrets/secrets.env
# Kustomize turns it into the `pgs-secrets` Secret. LOCAL DEVELOPMENT placeholders only:
# use real values (or an external secret store) for anything shared. Passwords end up in
# connection URLs, so keep them URL-safe (letters, digits, - _ .).

# PostgreSQL schema owner (migrations and seeding only)
POSTGRES_USER=pgs
POSTGRES_PASSWORD=pgs
POSTGRES_DB=pgs

# Per-service login roles (created by the migrations; db-bootstrap sets these passwords)
PGS_API_DB_PASSWORD=pgs_api_dev
PGS_ETL_DB_PASSWORD=pgs_etl_dev
PGS_SEARCH_DB_PASSWORD=pgs_search_dev
PGS_SCRAPER_DB_PASSWORD=pgs_scraper_dev

# Airflow
AIRFLOW_DB_PASSWORD=airflow
AIRFLOW_ADMIN_USERNAME=airflow
AIRFLOW_ADMIN_PASSWORD=airflow
AIRFLOW_SECRET_KEY=dummy_dev_secret_change_me
# Optional; generate with
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=

# Temporal's own PostgreSQL (optional `scraper` part)
TEMPORAL_DB_PASSWORD=temporal
