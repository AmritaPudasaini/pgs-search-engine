# Environment for the root docker-compose.yml. Copy to .env (never commit .env):
#   cp .env.example .env
# Every value below is a LOCAL DEVELOPMENT placeholder. Use real secrets, from a secret
# store, for any shared or deployed environment. Passwords end up inside connection
# URLs, so keep them URL-safe (letters, digits, - _ .).

# -- Optional services (comma-separated): ui, scraper, search, tools ---------------
# e.g. COMPOSE_PROFILES=search,tools
COMPOSE_PROFILES=

# -- PostgreSQL: schema owner (migrations and seeding only) ------------------------
# Same values as database/.env.example, so host-side tools keep using
# DATABASE_URL=postgresql+psycopg://pgs:pgs@localhost:5432/pgs
POSTGRES_USER=pgs
POSTGRES_PASSWORD=pgs
POSTGRES_DB=pgs
POSTGRES_PORT=5432

# -- PostgreSQL: per-service login roles --------------------------------------------
# The roles are created by the migrations; db-role-passwords sets these passwords.
PGS_API_DB_PASSWORD=pgs_api_dev
PGS_ETL_DB_PASSWORD=pgs_etl_dev
PGS_SEARCH_DB_PASSWORD=pgs_search_dev
PGS_SCRAPER_DB_PASSWORD=pgs_scraper_dev

# -- Airflow --------------------------------------------------------------------------
# Your Linux/WSL user id (`id -u`, usually 1000), so Airflow's files in ETL/airflow/logs
# belong to you.
AIRFLOW_UID=1000
AIRFLOW_DB_PASSWORD=airflow
AIRFLOW_ADMIN_USERNAME=airflow
AIRFLOW_ADMIN_PASSWORD=airflow
AIRFLOW_SECRET_KEY=dummy_dev_secret_change_me
# Optional: encrypts connection passwords Airflow stores. Generate with
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
# AIRFLOW_WEBSERVER_WORKERS=2
# AIRFLOW_WORKER_CONCURRENCY=4

# -- Host ports (all bound to 127.0.0.1) ----------------------------------------------
API_PORT=8000
UI_PORT=3000
AIRFLOW_PORT=8080
OPENSEARCH_PORT=9200
# Also the advertised host listener (localhost:<port>) the phase-1 Kafka scripts use.
KAFKA_PORT=9092
# OPENSEARCH_DASHBOARDS_PORT=5601
# SEARCH_GRPC_PORT=50051
# TEMPORAL_UI_PORT=8233

# -- Memory (JVM heaps; local-development sizing) -------------------------------------
# OPENSEARCH_JAVA_OPTS=-Xms512m -Xmx512m
# KAFKA_HEAP_OPTS=-Xms512m -Xmx512m

# -- Build-time (inlined into the UI's browser bundle; a host URL) --------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# -- Search engine / scraper ------------------------------------------------------------
# OPENSEARCH_INDEX=np_web_pages
# ndjson | postgres | kafka
# SCRAPER_STORAGE=ndjson
